{
  "name": "northstar-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/local-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "NODE_ENV=test JWT_SECRET=test-only-jwt-secret-at-least-32-characters npm run build && NODE_ENV=test JWT_SECRET=test-only-jwt-secret-at-least-32-characters node --test dist/services/scoring.service.test.js dist/services/xai-search.service.test.js dist/services/research-scheduler.service.test.js dist/middlewares/sanitize.test.js dist/validators/auth.validator.test.js dist/controllers/auth.controller.test.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "eslint": "^10.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}

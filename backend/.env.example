PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agency-os
# Keep this value quoted when it contains #, whitespace, or other dotenv comment characters.
JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Live discovery through Grok web search. Keep the key server-side only.
XAI_API_KEY=
XAI_MODEL=grok-4.6
